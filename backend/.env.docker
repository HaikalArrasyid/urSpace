APP_NAME=urSpace
APP_ENV=local
APP_KEY=base64:TN6Evas5oOqXpQG7Fe7sKPRtPrSOH9GHrkfR0o5QivQ=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ============================================================================
# DATABASE — PERUBAHAN PENTING!
# ============================================================================
# DB_HOST=mysql → INI YANG BEDA dari .env biasa!
# Di Docker, container saling "ngobrol" pakai NAMA SERVICE-nya
# (yang kita tulis di docker-compose.yml), BUKAN localhost/127.0.0.1.
# Jadi "mysql" di sini = container MySQL yang kita definisikan di compose.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ukk_reserve
DB_USERNAME=root
DB_PASSWORD=password

# ============================================================================
# DRIVER — semua pakai database (ga butuh Redis)
# ============================================================================
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

BCRYPT_ROUNDS=12